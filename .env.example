APP_NAME=Watchline
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://watchline-new.test
APP_LOCALE=hr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

WATCHLINE_SOURCE_HOSTNAME=127.0.0.1
WATCHLINE_SOURCE_PORT=33107
WATCHLINE_SOURCE_DATABASE=watchline_snapshot_20261023
WATCHLINE_SOURCE_USERNAME=root
WATCHLINE_SOURCE_PASSWORD=
# Separate local frozen snapshot, named watchline_snapshot_YYYYMMDD (never the live database).
WATCHLINE_FINAL_SOURCE_DATABASE=

STOREFRONT_THEME=herrera
STOREFRONT_HOME=watchline
STOREFRONT_BRAND=libermedia
STORE_B2C_ONLY=true
STORE_B2B_ONLY=false
STORE_B2B_DISPLAY_NET=false
HERRERA_LOCAL_SAFE_MODE=true

LEGACY_MEDIA_ENABLED=true
LEGACY_MEDIA_ORIGIN=https://www.watchline.hr
LEGACY_MEDIA_DIRECTORIES=catalog,data

STOCK_NOTIFICATIONS_ENABLED=false
STOCK_NOTIFICATIONS_EMAILS_ENABLED=false
GIFT_VOUCHERS_ENABLED=true
GIFT_VOUCHER_CODE_PREFIX=WATCH-
GIFT_VOUCHER_EMAILS_ENABLED=false

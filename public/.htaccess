<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    DirectoryIndex index.php

    RewriteEngine On

    # Resolve both the MODX address and the public hostname in one redirect.
    RewriteCond %{HTTP_HOST} ^(?:(?:www|shop)\.)?lavaggio\.hr(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteRule ^(?:blog|usluge|o-praonici|cjenik|index)(?:/.*)?$ index.php [END]

    # Preserve the original host for existing signed links and provider callbacks.
    RewriteCond %{HTTP_HOST} ^(?:shop\.)?lavaggio\.hr(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{QUERY_STRING} !(^|&)signature= [NC]
    RewriteCond %{REQUEST_URI} !^/(?:api(?:/|$)|checkout/(?:corvus|keks|wspay)(?:/|$)|account/impersonation/) [NC]
    RewriteRule ^ https://www.lavaggio.hr%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^lavaggio\.hr(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://www.lavaggio.hr%{REQUEST_URI} [R=308,L,NE]

    # Force HTTPS outside local development while preserving the requested host.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Keep robots environment-aware even when an older static file is present.
    RewriteRule ^robots\.txt$ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|avif|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "_service-worker.js">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </Files>
</IfModule>

<Files ".user.ini">
    Require all denied
</Files>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<Files "error_log">
    Require all denied
</Files>
